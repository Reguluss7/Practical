  <diagram id="classes" name="Classes">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls-hotel" value="&lt;b&gt;Hotel&lt;/b&gt;&lt;hr&gt;- name: str&lt;br&gt;- rooms: dict[str, Room]&lt;br&gt;- bookings: dict[str, Booking]&lt;hr&gt;+ add_room(room)&lt;br&gt;+ find_available_rooms(in, out, type)&lt;br&gt;+ book_room(num, guest, in, out)&lt;br&gt;+ cancel_booking(booking_id)&lt;br&gt;+ get_guest_bookings(guest_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
