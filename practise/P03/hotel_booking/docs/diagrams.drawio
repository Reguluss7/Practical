---

## 3. `docs/diagrams.drawio`

Save this XML as `docs/diagrams.drawio` and open it in [draw.io](https://app.diagrams.net) or the VS Code Draw.io extension. It contains all 5 pages.

```xml
<mxfile host="app.diagrams.net">
  <diagram id="use-cases" name="Use cases">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="uc-sys" value="Hotel Booking System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="380" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="uc-admin" value="Hotel Staff" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="30" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="uc-guest" value="Guest" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="30" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="uc-r1" value="R1: Add Room" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="90" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="uc-r2" value="R2: Search Available Rooms" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="175" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="uc-r3" value="R3: Book a Room" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="260" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="uc-r4" value="R4: Cancel Booking" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="310" y="345" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="uc-r5" value="R5: View Guest Bookings" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="425" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="uc-admin" target="uc-r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="uc-guest" target="uc-r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="uc-guest" target="uc-r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="uc-guest" target="uc-r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="uc-guest" target="uc-r5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="classes" name="Classes">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls-hotel" value="&lt;b&gt;Hotel&lt;/b&gt;&lt;hr&gt;- name: str&lt;br&gt;- rooms: dict[str, Room]&lt;br&gt;- bookings: dict[str, Booking]&lt;hr&gt;+ add_room(room)&lt;br&gt;+ find_available_rooms(in, out, type)&lt;br&gt;+ book_room(num, guest, in, out)&lt;br&gt;+ cancel_booking(booking_id)&lt;br&gt;+ get_guest_bookings(guest_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="240" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="cls-room" value="&lt;b&gt;Room&lt;/b&gt;&lt;hr&gt;+ room_number: str&lt;br&gt;+ room_type: RoomType&lt;br&gt;+ nightly_rate: float" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cls-booking" value="&lt;b&gt;Booking&lt;/b&gt;&lt;hr&gt;+ booking_id: str&lt;br&gt;+ room: Room&lt;br&gt;+ guest: Guest&lt;br&gt;+ check_in: date&lt;br&gt;+ check_out: date&lt;br&gt;+ status: BookingStatus&lt;hr&gt;+ nights(): int&lt;br&gt;+ total_price(): float&lt;br&gt;+ overlaps(in, out): bool&lt;br&gt;+ cancel(): None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="210" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="cls-guest" value="&lt;b&gt;Guest&lt;/b&gt;&lt;hr&gt;+ guest_id: str&lt;br&gt;+ name: str&lt;br&gt;+ email: str" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="240" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rel1" value="1..*" style="endArrow=open;html=1;" edge="1" parent="1" source="cls-hotel" target="cls-room"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel2" value="0..*" style="endArrow=open;html=1;" edge="1" parent="1" source="cls-hotel" target="cls-booking"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel3" value="1" style="endArrow=open;html=1;" edge="1" parent="1" source="cls-booking" target="cls-room"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel4" value="1" style="endArrow=open;html=1;" edge="1" parent="1" source="cls-booking" target="cls-guest"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-book" name="Sequence - book">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sb-guest" value="Guest" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="100" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="sb-hotel" value="Hotel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="100" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="sb-booking" value="Booking" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="100" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="book_room(room_num, guest, in, out)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="130" as="sourcePoint"/>
            <mxPoint x="390" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="validate dates &amp; room exists" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="175" as="sourcePoint"/>
            <mxPoint x="390" y="205" as="targetPoint"/>
            <Array as="points"><mxPoint x="460" y="175"/><mxPoint x="460" y="205"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="overlaps(in, out) [for existing bookings]" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="245" as="sourcePoint"/>
            <mxPoint x="650" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="False (no conflict)" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="285" as="sourcePoint"/>
            <mxPoint x="390" y="285" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;&lt;create&gt;&gt; Booking(CONFIRMED)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="340" as="sourcePoint"/>
            <mxPoint x="650" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="return booking (with total_price)" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="400" as="sourcePoint"/>
            <mxPoint x="130" y="400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-cancel" name="Sequence - cancel">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sc-guest" value="Guest" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="100" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="sc-hotel" value="Hotel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="100" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="sc-booking" value="Booking" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="100" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="cm1" value="cancel_booking(booking_id)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="130" as="sourcePoint"/>
            <mxPoint x="390" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="cm2" value="lookup booking_id (raise if missing)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="170" as="sourcePoint"/>
            <mxPoint x="390" y="200" as="targetPoint"/>
            <Array as="points"><mxPoint x="460" y="170"/><mxPoint x="460" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cm3" value="cancel()" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="240" as="sourcePoint"/>
            <mxPoint x="650" y="240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="cm4" value="status = CANCELLED" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="285" as="sourcePoint"/>
            <mxPoint x="390" y="285" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="cm5" value="return cancelled booking" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="340" as="sourcePoint"/>
            <mxPoint x="130" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="act-book" name="Activity - book">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="650">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a-start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="385" y="30" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a-dates" value="check_out &gt; check_in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="95" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-room" value="Room exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="205" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-avail" value="No overlapping&#xa;CONFIRMED booking?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="315" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-create" value="Create Booking (CONFIRMED)&#xa;&amp; Compute Total Price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="290" y="440" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a-err" value="Raise ValueError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="215" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a-end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="385" y="540" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" edge="1" parent="1" source="a-start" target="a-dates"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" value="Yes" edge="1" parent="1" source="a-dates" target="a-room"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae3" value="Yes" edge="1" parent="1" source="a-room" target="a-avail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae4" value="Yes" edge="1" parent="1" source="a-avail" target="a-create"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae5" edge="1" parent="1" source="a-create" target="a-end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae6" value="No" edge="1" parent="1" source="a-dates" target="a-err"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae7" value="No" edge="1" parent="1" source="a-room" target="a-err"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae8" value="No" edge="1" parent="1" source="a-avail" target="a-err"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>